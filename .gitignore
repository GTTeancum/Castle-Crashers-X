# Retail Xbox 360 LIVE/STFS game package — never commit game content
/Castle Crashers

# Emulator runtime material (BIOS, MCPX, EEPROM, HDD images, AppImages)
*.AppImage
Complex_*.bin
mcpx_*.bin
eeprom.bin
*.qcow2
*.vhd

# Host build outputs
build/
build-release/
build-asan/
build-*/
out/
CMakeFiles/
CMakeCache.txt
*.o
*.obj
*.exe
*.pdb

# Editor/OS noise
.vs/
*.swp
Thumbs.db
Desktop.ini

# Game data extracted from the retail LIVE container (reproducible via castle-crashers-port/tools/extract_stfs.py)
game-data/extracted/

# nxdk build outputs (reproducible via tools/build_widget011_nxdk.sh)
nxdk-*/bin/default.xbe
nxdk-*/*.iso
nxdk-*/main.exe
nxdk-*/main.map
**/*.obj
**/*.su
**/*.cpp.d
**/*.c.d
.claude/

# raw frame captures (large; rendered PNGs are kept)
logs/**/*.ccframe
logs/devdump/
logs/run_*.txt
logs/nxdk_build.txt
__pycache__/

# Audio converted from the retail game (never commit game content)
game-data/converted/

# Recorded or excerpted game audio (game content)
logs/*.wav
logs/*.mp3

# Disc image staging (game data copied at build time; never commit)
nxdk-checkpoint022/bin/
*.iso

# Game-derived test inputs kept local only: the program image and captured
# game memory/render snapshots (.cct/.ccr). Supply them separately on a
# fresh clone.
castle-crashers-port/reference/default.image.bin
*.cct
*.ccr
logs/frames_bake/
logs/frames_*/
logs/xemu_*/
logs/run_*.txt
logs/console/
nxdk-checkpoint022/main.map
# Console power tool build outputs
tools/xbox_power/bin/
tools/xbox_power/*.obj
tools/xbox_power/*.d
tools/xbox_power/*.xbe
tools/xbox_power/main.exe*
tools/xbox_power/main.lib

# Installer runs and checks, texture recipe recordings (game data)
game-data/installer-check/
game-data/installer-out/
game-data/texrecipes/
game-data/packz/
