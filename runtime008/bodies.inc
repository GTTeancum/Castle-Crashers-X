    if (!g_vc_stats) g_vc_stats = new std::unordered_map<uint32_t, CcVcStat>();
    CcVcStat& st = (*g_vc_stats)[lr];
    ++st.calls;
    if (fn != s.e[0].key && fn != s.e[1].key) ++st.misses;
