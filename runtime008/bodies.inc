static inline __attribute__((always_inline)) uint32_t cc_vcall_site(Context& ctx, Machine& base, uint32_t obj, uint32_t slot, uint32_t lr, CcVSite& s) {
  const uint32_t fn = REX_LOAD_U32(REX_LOAD_U32(obj) + slot);
