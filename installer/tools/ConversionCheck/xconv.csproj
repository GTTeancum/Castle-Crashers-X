<Project Sdk="Microsoft.NET.Sdk">
  <!-- Installer conversion checks without the window (same Conversion code). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\CastleCrashersXInstaller\Conversion\*.cs" />
    <Compile Include="..\..\CastleCrashersXInstaller\GlobalUsings.cs" />
  </ItemGroup>
</Project>
